<?xml version="1.0" encoding="UTF-8"?>
<!--
    Table name authoritative at its default only: TableNameListener applies
    `outbox.table`. Written by JobTracker through DBAL: its columns are the
    contract. Index names are left to Doctrine.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="AlexandreBulete\DddOutboxBundle\Domain\Model\Job" table="outbox_job">
        <id name="id" type="outbox_job_id"/>
        <field name="message" type="string" length="255"/>
        <field name="transport" type="string" length="190"/>
        <field name="status" type="string" length="16" enum-type="AlexandreBulete\DddOutboxBundle\Domain\ValueObject\JobStatus"/>
        <field name="attempts" type="integer"/>
        <field name="lastError" type="text" column="last_error" nullable="true"/>
        <field name="actorKind" type="string" column="actor_kind" length="10"/>
        <field name="actorId" type="string" column="actor_id" length="64" nullable="true"/>
        <field name="actorLabel" type="string" column="actor_label" length="255"/>
        <field name="correlationId" type="string" column="correlation_id" length="64"/>
        <field name="causationId" type="string" column="causation_id" length="64" nullable="true"/>
        <field name="queuedAt" type="datetime_immutable" column="queued_at"/>
        <field name="startedAt" type="datetime_immutable" column="started_at" nullable="true"/>
        <field name="finishedAt" type="datetime_immutable" column="finished_at" nullable="true"/>

        <indexes>
            <index columns="status"/>
            <index columns="queued_at"/>
            <index columns="correlation_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
